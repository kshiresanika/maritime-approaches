.env
*.env
.DS_Store

# Appended at first publish: hard exclusions for GitHub limits.
yolov8n.pt
02_data/**/*.csv
02_data/**/*.zip
*.log

# --- 02_data/golden/ : REAL IDENTITIES. Added before make_golden_window.py is first run.
# The rule ignores FILES, not the directory, on purpose. git cannot re-include a file
# that sits below an ignored DIRECTORY, so "02_data/golden/" followed by a negation
# silently fails and commits nothing -- or worse, a later edit un-ignores everything.
02_data/golden/*.csv
02_data/golden/*.json
# Only the pseudonymised window may ever be committed (999-prefixed synthetic MMSIs).
!02_data/golden/*_anon.csv
# The MMSI mapping table re-identifies every pseudonym. It must NEVER be committed,
# so it is re-ignored AFTER the negation above -- last matching rule wins in git.
02_data/golden/*mmsi_map*
02_data/golden/*_real*

# Synthetic EO demo output: regenerated by 04_demo/make_synthetic_eo.py, not source.
04_demo/out/

# lane F: bench_edge.py output. Regenerated per run; the .md carries the
# committed numbers, the .json is the raw artefact.
04_demo/edge_benchmark.json

# Session backups. The repo is PUBLIC; a .bak of evidence.py or server.py
# publishes a superseded copy of the code the case files are built from.
*.bak-*
